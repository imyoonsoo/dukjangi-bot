# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# lighthouse ci (로컬 실행 시 생기는 리포트 출력 디렉터리)
/.lighthouseci/

# 코드리뷰 워크플로우가 노션 전송용으로 잠깐 만드는 파일
/notion_review.json
/notion_response.json

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# vscode
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
